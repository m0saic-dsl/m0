{
  "extends": "./tsconfig.json",
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/__tests__/**"],
  "compilerOptions": {
    "outDir": "dist/esm",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationDir": "dist/types"
  }
}
