{
  "extends": "./tsconfig.json",
  "exclude": ["dist", "node_modules", "**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/__tests__/**"],
  "compilerOptions": {
    "outDir": "dist/cjs",
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "esModuleInterop": true,
    "declaration": false,
    "ignoreDeprecations": "6.0"
  }
}
